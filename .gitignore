# deps / build
node_modules/
dist/
build/
*.tsbuildinfo

# the ~185MB model is fetched at runtime & cached by the browser — never commit it
*.onnx
models/

# the onnxruntime-web runtime (23.5MB .wasm) is copied out of node_modules at build
# time by the copyOrtRuntime plugin in vite.config.ts — never commit it either
public/ort/

# env / secrets
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# scratch
scratchpad/
tmp/
